# Bu dosyayı ".env" adıyla kopyalayın (Render'da bunları Environment bölümüne ekleyin)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
# Supabase > Project Settings > API: "Project URL" ve "service_role" (secret) anahtarı
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...service_role_anahtari
# İsteğe bağlı: sadece bu chat ID'ler botu kullanabilsin (virgülle). Boş = herkes.
ALLOWED_CHAT_IDS=
# İsteğe bağlı: Gemini yapay zekâ yorumu (aistudio.google.com > Get API key, ücretsiz). Boş = kural tabanlı yorum.
GEMINI_API_KEY=
